generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  cnpj        String   @unique
  responsible String
  email       String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams    Team[]
  projects Project[]
  users    User[]
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  members  User[]
  projects Project[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("member") // admin, member, super_admin
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  tasks Task[] @relation("Assignee")

  comments      Comment[]
  refreshTokens RefreshToken[]
}

// Story 032: refresh token opaco (nunca guardado em texto puro — só o hash)
// para permitir revogação/rotação, ao contrário de um JWT stateless.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("active") // active, inactive, archived
  startDate   DateTime?
  endDate     DateTime?
  githubOwner String?
  githubRepo  String?
  githubProjectNumber Int? // GitHub Projects v2 number (org/user project)
  githubProjectId     String? // GraphQL node id (PVT_...)
  githubProjectUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  sprints Sprint[]
  tasks   Task[]

  @@unique([companyId, githubProjectId])
}

model Sprint {
  id             String   @id @default(uuid())
  name           String
  goal           String?
  status         String   @default("planning") // planning, active, completed, cancelled
  startDate      DateTime
  endDate        DateTime
  capacityPoints Int?     // capacidade planejada do sprint (story points)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks Task[]
}

model Task {
  id                String   @id @default(uuid())
  title             String
  description       String?
  type              String   @default("task") // story, bug, task, epic
  status            String   @default("todo") // todo, in_progress, done
  priority          String   @default("medium") // low, medium, high
  storyPoints       Int?
  githubIssueNumber Int?
  githubIssueUrl    String?
  githubProjectItemId String? // ProjectV2Item id (DraftIssue etc.)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId String?
  sprint   Sprint?  @relation(fields: [sprintId], references: [id])

  assigneeId String?
  assignee  User?   @relation("Assignee", fields: [assigneeId], references: [id])

  comments Comment[]

  @@unique([projectId, githubIssueNumber])
  @@unique([projectId, githubProjectItemId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}