DB_HOST=localhost
DB_PORT=5434
DB_USER=admin
DB_PASSWORD=admin_password
DB_NAME=sprinthub_dev
DATABASE_URL="postgresql://admin:admin_password@localhost:5434/sprinthub_dev"

GO_AUTH_URL=http://localhost:8081/api/v1
GO_CLIENT_ID=sprinthub-backend
GO_CLIENT_SECRET=changeme
GO_REDIRECT_URI=http://localhost:3005/api/auth/callback

# Valor abaixo é só exemplo — a aplicação recusa subir (main.ts) se
# JWT_SECRET estiver ausente ou for exatamente este valor. Gere uma chave
# própria por ambiente (ex: openssl rand -hex 32).
JWT_SECRET=sprinthub-secret-key

# Opcionais — Story 032 (token curto + refresh token). Defaults no código
# se omitidos: access 15m, refresh 30 dias.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN_DAYS=30

# Opcional — sync Issues → Tasks (Story 025+)
# GITHUB_TOKEN=ghp_xxxxxxxx
# Escopos: repo (ou public_repo) + read:project (para Projects v2)

# Reabre o dev-login mesmo com NODE_ENV=production. O "Go Auth" acima nunca
# foi implementado (Story 032), então isso é o único login funcional fora de
# dev — só ligar em ambiente sem exposição à internet.
# ALLOW_DEV_LOGIN=true

# Porta local da API (Coolify define a sua propria via env)
PORT=3005
