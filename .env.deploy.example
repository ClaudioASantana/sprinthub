# Variáveis lidas pelo docker-compose.yml no servidor de deploy.
# Copie para ".env" na raiz do projeto no servidor (nunca commitar o .env real).

POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sprinthub_prod

# Gere com: openssl rand -hex 32
JWT_SECRET=

# O "Go Auth" nunca foi implementado (ver Story 032) — deixe essas 4 vazias
# por enquanto. Enquanto isso, ALLOW_DEV_LOGIN reabre o dev-login (que é o
# único login que funciona hoje) mesmo em produção. Só é seguro porque este
# servidor fica na LAN, sem exposição à internet. Revisar quando houver um
# provedor de auth real.
GO_AUTH_URL=
GO_CLIENT_ID=
GO_CLIENT_SECRET=
GO_REDIRECT_URI=
ALLOW_DEV_LOGIN=true

# Opcional — sync Issues → Tasks
# GITHUB_TOKEN=ghp_xxxxxxxx

# Porta publicada do frontend (nginx) no host
FRONTEND_PORT=8080
